      "reclassified_from": "phase_r_restoration_hard_gate",
      "threshold_unchanged": true,
      "historical_runs": "inadmissible_for_quality_adjudication",
      "reason": "Restoration (operational viability) and optimization (per-role model quality) are separate questions; this benchmark answers the second, not the first."
    }
  ]
