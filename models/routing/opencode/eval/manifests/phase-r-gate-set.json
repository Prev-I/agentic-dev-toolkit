      "evidence": "eval/records/phase-r/effective-routing.json"
    },
    {
      "gate": "security_permissions",
      "evidence": "eval/records/phase-r/security/reviewer.json, eval/records/phase-r/security/expert.json"
    },
    {
      "gate": "breakglass_boundary",
      "evidence": "eval/records/phase-r/security/breakglass-non-exposure.json, eval/records/phase-r/security/breakglass-primary.json"
    },
    {
      "gate": "build_operational_restoration",
      "evidence": "eval/records/phase-r/build/outcome.json"
    },
    {
      "gate": "explore_operational_gate",
      "evidence": "eval/records/phase-r/explore/outcome.json"
    },
    {
      "gate": "compaction_invariant_preservation",
      "evidence": "eval/records/phase-r/compaction/outcome.json"
    },
    {
      "gate": "reviewer_operational_integration",
      "evidence": "eval/records/phase-r/security/reviewer.json, eval/records/phase-r/effective-routing.json, eval/records/phase-r/reviewer/*/dispatch/dispatch.json, eval/records/phase-r/reviewer/findings.json",
      "required_properties": [
        "model_resolves",
