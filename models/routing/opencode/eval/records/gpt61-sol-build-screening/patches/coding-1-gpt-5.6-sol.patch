+test_installer_bootstrap_guards_managed_path_entries() {
+  local home="$TEMP_DIR/bootstrap home"
+  local initial_path="/original:$home/.opencode/bin:/original"
+  local actual
+
+  mkdir -p "$home/.local/bin" "$home/.opencode/bin"
+  actual="$(HOME="$home" PATH="$initial_path" "$BASH_BIN" --noprofile --norc -c '
+    source "$1"
+    printf "%s" "$PATH"
+  ' _ "$TEMP_DIR/install-functions.sh")"
+
+  assert_equal "$actual" "$home/.local/bin:$initial_path" \
+    "bootstrap PATH must add only existing exact entries and preserve the original PATH"
+}
+
+test_installer_bootstrap_preserves_an_empty_path_entry() {
+  local home="$TEMP_DIR/bootstrap empty home"
+  local actual
+
+  mkdir -p "$home/.local/bin" "$home/bin" "$home/.opencode/bin"
+  actual="$(HOME="$home" PATH="" "$BASH_BIN" --noprofile --norc -c '
+    source "$1"
+    printf "%s" "$PATH"
+  ' _ "$TEMP_DIR/install-functions.sh")"
+
+  assert_equal "$actual" "$home/.local/bin:$home/bin:$home/.opencode/bin:" \
+    "bootstrap PATH must preserve an initially empty PATH entry"
+}
+
+test_managed_bash_block_guards_path_entries_on_repeated_activation() (
+  local home="$TEMP_DIR/managed block home"
+  local initial_path="/original:$home/.local/bin:/again:$home/.local/bin:$home/bin-tools"
+  local actual
+
+  HOME="$home"
+  PATH="/usr/bin:/bin"
+  DRY_RUN=0
+  mkdir -p "$HOME/.local/bin" "$HOME/bin" "$HOME/.opencode/bin"
+  ensure_shell_configuration >/dev/null
+
+  actual="$(HOME="$home" PATH="$initial_path" "$BASH_BIN" --noprofile --norc -c '
+    direnv() { printf ":"; }
+    source "$1"
+    source "$1"
+    printf "%s" "$PATH"
+  ' _ "$home/.bashrc")"
+
+  assert_equal "$actual" "$home/bin:$home/.opencode/bin:$initial_path" \
+    "managed Bash PATH must use exact entries and remain idempotent"
+)
+
+test_managed_bash_block_preserves_an_empty_path_entry() (
