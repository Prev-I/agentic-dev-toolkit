+assert_managed_path_at_site() {
+  local site="$1" home="$2" input="$3" expected="$4" message="$5"
+  local bash_bin tools_path actual
+  bash_bin="$(command -v bash)"
+  tools_path="$PATH"
+
+  # A fresh Bash avoids re-sourcing readonly installer globals. Only the
+  # functions-only copy is sourced; main is never run. Command wrappers keep
+  # configuration file operations available even when the tested PATH is empty.
+  actual="$("$bash_bin" --noprofile --norc -c '
+    set -Eeuo pipefail
+    site="$1"; export HOME="$2"; input="$3"; functions="$4"; tools_path="$5"
+    if [[ "$site" == bootstrap ]]; then
+      export PATH="$input"
+      source "$functions"
+    else
+      source "$functions"
+      for tool in mkdir touch mktemp awk cat cmp cp mv rm; do
+        eval "$tool() { PATH=\"\$tools_path\" command $tool \"\$@\"; }"
+      done
+      DRY_RUN=0
+      if [[ "$site" == refresh ]]; then
+        export PATH="$input"
+        ensure_shell_configuration >/dev/null
+        first="$PATH"
+        ensure_shell_configuration >/dev/null
+      else
+        local_dir_existed=0
+        [[ ! -d "$HOME/.local/bin" ]] || local_dir_existed=1
+        ensure_shell_configuration >/dev/null
+        (( local_dir_existed == 1 )) || rm -rf "$HOME/.local/bin"
+        # Avoid activating real tools while exercising the emitted Bash block.
+        direnv() { printf "%s\n" ":"; }
+        export PATH="$input"
+        source "$HOME/.bashrc"
+        first="$PATH"
+        source "$HOME/.bashrc"
+      fi
+      [[ "$PATH" == "$first" ]] || { printf "FAIL: repeated activation changed PATH\n" >&2; exit 1; }
+    fi
+    printf "%s" "$PATH"
+  ' managed-path "$site" "$home" "$input" "$TEMP_DIR/install-functions.sh" "$tools_path")"
+  assert_equal "$actual" "$expected" "$site: $message"
+
+  if [[ "$site" == bootstrap ]]; then
+    actual="$("$bash_bin" --noprofile --norc -c '
+      export HOME="$1" PATH="$2"
+      source "$3"
+      printf "%s" "$PATH"
+    ' managed-path "$home" "$actual" "$TEMP_DIR/install-functions.sh")"
+    assert_equal "$actual" "$expected" "bootstrap: repeated activation must preserve PATH"
+  fi
+}
+
+test_managed_path_guards_at_all_sites() {
+  local site home local_bin user_bin opencode_bin original
+  for site in bootstrap refresh bashrc; do
+    home="$TEMP_DIR/path-$site/home [guards] with spaces"
+    local_bin="$home/.local/bin"
+    user_bin="$home/bin"
+    opencode_bin="$home/.opencode/bin"
+    mkdir -p "$local_bin" "$user_bin" "$opencode_bin"
+
+    assert_managed_path_at_site "$site" "$home" '/usr/bin:/bin' \
+      "$local_bin:$user_bin:$opencode_bin:/usr/bin:/bin" "new entries must retain priority"
+    assert_managed_path_at_site "$site" "$home" '' \
+      "$local_bin:$user_bin:$opencode_bin:" "empty PATH must retain its empty entry"
+
+    original="$opencode_bin::/usr/bin:$local_bin:$user_bin:$local_bin:/usr/bin:"
+    assert_managed_path_at_site "$site" "$home" "$original" "$original" \
+      "existing entries, order, duplicates and empty entries must remain exact"
+    original="/usr/bin:$user_bin:/bin"
+    assert_managed_path_at_site "$site" "$home" "$original" \
+      "$local_bin:$opencode_bin:$original" "only missing entries must be prepended"
+    original="$local_bin-extra:/prefix$user_bin:$opencode_bin/child:$local_bin/"
+    assert_managed_path_at_site "$site" "$home" "$original" \
+      "$local_bin:$user_bin:$opencode_bin:$original" "partial matches must not count as exact entries"
+
+    rm -rf "$user_bin" "$opencode_bin"
+    touch "$user_bin"
+    assert_managed_path_at_site "$site" "$home" '/usr/bin' \
+      "$local_bin:/usr/bin" "files and missing directories must not be added"
+    original="$user_bin:/usr/bin:$opencode_bin:"
+    assert_managed_path_at_site "$site" "$home" "$original" "$local_bin:$original" \
+      "pre-existing entries must remain even when their directories do not exist"
+
+    rm -rf "$local_bin"
+    if [[ "$site" == refresh ]]; then
+      # The existing configuration step creates .local/bin before refreshing.
+      assert_managed_path_at_site "$site" "$home" '' "$local_bin:" \
+        "refresh must include the directory created by configuration"
+    else
+      assert_managed_path_at_site "$site" "$home" '' '' \
+        "no existing managed directories must leave empty PATH untouched"
+    fi
+  done
+}
+
+test_shell_configuration_preserves_profile_and_backup() (
+  HOME="$TEMP_DIR/path-profile/home"
+  DRY_RUN=0
+  mkdir -p "$HOME"
+  printf '%s\n' '# user profile' > "$HOME/.bashrc"
+  ensure_shell_configuration >/dev/null
+  assert_equal "$(<"$HOME/.bashrc.pre-agentic-dev-toolkit")" '# user profile' \
+    "configuration must back up the original profile"
+  [[ "$(<"$HOME/.bashrc")" == '# user profile'* ]] || fail "user profile must be preserved"
+  assert_equal "$(grep -c '^# >>> agentic-dev-toolkit >>>$' "$HOME/.bashrc")" 1 "one start marker"
+  assert_equal "$(grep -c '^# <<< agentic-dev-toolkit <<<$' "$HOME/.bashrc")" 1 "one end marker"
+  ensure_shell_configuration >/dev/null
+  assert_equal "$(grep -c '^# >>> agentic-dev-toolkit >>>$' "$HOME/.bashrc")" 1 "reconfiguration must replace the block"
+  assert_equal "$(grep -c '^# <<< agentic-dev-toolkit <<<$' "$HOME/.bashrc")" 1 "reconfiguration must retain one end marker"
+  assert_equal "$(<"$HOME/.bashrc.pre-agentic-dev-toolkit")" '# user profile' \
+    "reconfiguration must preserve the original backup"
+
+  # Exercise both activation hooks without invoking workstation tools.
+  printf '#!/bin/bash\nprintf "export TEST_MISE_ACTIVATED=yes\\n"\n' > "$HOME/.local/bin/mise"
+  chmod 755 "$HOME/.local/bin/mise"
+  direnv() { printf '%s\n' 'export TEST_DIRENV_ACTIVATED=yes'; }
+  unset TEST_MISE_ACTIVATED TEST_DIRENV_ACTIVATED
+  source "$HOME/.bashrc"
+  assert_equal "${TEST_MISE_ACTIVATED:-}" yes "managed block must activate mise"
+  assert_equal "${TEST_DIRENV_ACTIVATED:-}" yes "managed block must activate direnv"
+)
+
+test_shell_configuration_dry_run_preserves_path_and_home() (
+  HOME="$TEMP_DIR/path-dry-run/nonexistent-home"
+  DRY_RUN=1
+  local original_path="$PATH"
+  ensure_shell_configuration >/dev/null
+  assert_equal "$PATH" "$original_path" "dry-run must not refresh PATH"
+  [[ ! -e "$HOME" ]] || fail "dry-run must not create HOME or shell configuration"
+)
