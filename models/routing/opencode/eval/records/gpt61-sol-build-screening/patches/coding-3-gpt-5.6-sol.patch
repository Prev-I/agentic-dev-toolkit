--- a/tests/install.sh
+++ b/tests/install.sh
@@ -105,6 +105,100 @@
   HOME="$original_home"
 }
 
+capture_bootstrap_path() {
+  local home="$1"
+  local initial_path="$2"
+
+  HOME="$home" PATH="$initial_path" /bin/bash --noprofile --norc -c '
+    source "$1"
+    printf %s "$PATH"
+  ' _ "$TEMP_DIR/install-functions.sh"
+}
+
+capture_bashrc_path() {
+  local home="$1"
+  local initial_path="$2"
+
+  HOME="$home" PATH="$initial_path" /bin/bash --noprofile --norc -c '
+    direnv() { :; }
+    source "$1"
+    source "$1"
+    printf %s "$PATH"
+  ' _ "$home/.bashrc"
+}
+
+test_managed_paths_preserve_empty_path_at_bootstrap_and_shell_activation() {
+  local original_home="$HOME"
+  local original_path="$PATH"
+  local managed_home="$TEMP_DIR/home with spaces"
+  local expected="$managed_home/.local/bin:$managed_home/bin:$managed_home/.opencode/bin:"
+
+  mkdir -p "$managed_home/.local/bin" "$managed_home/bin" "$managed_home/.opencode/bin"
+
+  assert_equal "$(capture_bootstrap_path "$managed_home" "")" "$expected" \
+    "installer bootstrap must preserve an empty PATH entry after managed directories"
+
+  HOME="$managed_home"
+  PATH=""
+  prepend_managed_paths
+  assert_equal "$PATH" "$expected" \
+    "current-process PATH refresh must preserve an empty PATH entry after managed directories"
+
+  PATH="$original_path"
+  DRY_RUN=0
+  ensure_shell_configuration >/dev/null
+  assert_equal "$(capture_bashrc_path "$managed_home" "")" "$expected" \
+    "managed Bash activation must preserve priority, spaces, and an empty PATH entry"
+
+  HOME="$original_home"
+  PATH="$original_path"
+}
+
+test_shell_configuration_adds_only_existing_exact_missing_paths_once() {
+  local original_home="$HOME"
+  local original_path="$PATH"
+  local managed_home="$TEMP_DIR/exact path home"
+  local initial_path="/usr/bin:/before:$managed_home/.local/bin-extra:$managed_home/bin:/before:"
+  local expected="$managed_home/.local/bin:$initial_path"
+
+  mkdir -p "$managed_home/.local/bin" "$managed_home/bin"
+  assert_equal "$(capture_bootstrap_path "$managed_home" "$initial_path")" "$expected" \
+    "installer bootstrap must add only existing exact missing PATH entries"
+
+  HOME="$managed_home"
+  PATH="$initial_path"
+  DRY_RUN=0
+
+  ensure_shell_configuration >/dev/null
+  ensure_shell_configuration >/dev/null
+
+  assert_equal "$PATH" "$expected" \
+    "current-process refresh must add only existing exact PATH entries without changing prior entries"
+  assert_equal "$(capture_bashrc_path "$managed_home" "$initial_path")" "$expected" \
+    "repeated managed Bash activation must not add duplicates or missing directories"
+
+  HOME="$original_home"
+  PATH="$original_path"
+}
+
+test_shell_configuration_dry_run_does_not_mutate_path_or_home() {
+  local original_home="$HOME"
+  local original_path="$PATH"
+  local managed_home="$TEMP_DIR/dry-run-home"
+
+  HOME="$managed_home"
+  PATH="/dry-run-path:"
+  DRY_RUN=1
+
+  ensure_shell_configuration >/dev/null
+
+  assert_equal "$PATH" "/dry-run-path:" "shell configuration dry-run must not mutate PATH"
+  [[ ! -e "$managed_home" ]] || fail "shell configuration dry-run must not create HOME content"
+
+  HOME="$original_home"
+  PATH="$original_path"
+}
+
 test_project_configuration_creates_direnv_file_when_missing() {
