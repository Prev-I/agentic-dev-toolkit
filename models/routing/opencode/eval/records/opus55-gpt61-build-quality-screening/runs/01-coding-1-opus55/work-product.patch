-export PATH="$HOME/.local/bin:$HOME/bin:$HOME/.opencode/bin:$PATH"
+# Prepends each managed directory that exists and is not already a complete
+# PATH entry; existing entries are never moved or removed. The list runs lowest
+# priority first, so .local/bin leads when all three are added. The managed Bash
+# block in ensure_shell_configuration repeats this loop for login shells.
+prepend_managed_path_dirs() {
+  local dir
+  for dir in "$HOME/.opencode/bin" "$HOME/bin" "$HOME/.local/bin"; do
+    if [[ -d "$dir" && ":$PATH:" != *":$dir:"* ]]; then
+      PATH="$dir:$PATH"
+    fi
+  done
+  export PATH
+}
+
+prepend_managed_path_dirs
 
 TEMP_PATHS=()
 DOWNLOADED_INSTALLER=""
@@ -393,7 +407,13 @@ ensure_shell_configuration() {
   cat >> "$temp_file" <<'EOF_BASHRC'
 
 # >>> agentic-dev-toolkit >>>
-export PATH="$HOME/.local/bin:$HOME/bin:$HOME/.opencode/bin:$PATH"
+for __adt_path_dir in "$HOME/.opencode/bin" "$HOME/bin" "$HOME/.local/bin"; do
+  if [[ -d "$__adt_path_dir" && ":$PATH:" != *":$__adt_path_dir:"* ]]; then
+    PATH="$__adt_path_dir:$PATH"
+  fi
+done
+unset __adt_path_dir
+export PATH
 export OPENCODE_ENABLE_EXA=true
 if [[ -x "$HOME/.local/bin/mise" ]]; then
   eval "$("$HOME/.local/bin/mise" activate bash)"
@@ -410,7 +430,7 @@ EOF_BASHRC
