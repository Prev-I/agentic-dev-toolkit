 test_lttng_selector_prefers_time64_package_when_available() {
@@ -105,6 +112,117 @@ test_shell_configuration_enables_direnv() {
   HOME="$original_home"
 }
 
+# Exercise the bootstrap, generated block, and process refresh independently.
+# Tool wrappers keep the refresh's file operations available even with PATH="".
+assert_managed_path() (
+  local site="$1" initial="$2" expected="$3" label="$4"
+  local tools_path="$PATH" bash_bin tool actual
+  bash_bin="$(command -v bash)"
+
+  case "$site" in
+    bootstrap)
+      actual="$(HOME="$HOME" PATH="$initial" "$bash_bin" --noprofile --norc -c '
+        source "$1"
+        printf "%s" "$PATH"
+      ' bash "$TEMP_DIR/install-functions.sh")"
+      assert_equal "$actual" "$expected" "$site: $label"
+      actual="$(HOME="$HOME" PATH="$actual" "$bash_bin" --noprofile --norc -c '
+        source "$1"
+        printf "%s" "$PATH"
+      ' bash "$TEMP_DIR/install-functions.sh")"
+      ;;
+    block)
+      # The activation dependencies are isolated; their emitted code is still
+      # evaluated, so dropping either activation makes the assertions fail.
+      direnv() { printf '%s\n' 'DIRENV_ACTIVATED=1'; }
+      PATH="$initial"
+      source "$HOME/.bashrc"
+      assert_equal "$PATH" "$expected" "$site: $label"
+      source "$HOME/.bashrc"
+      assert_equal "${MISE_ACTIVATED:-}" "1" "mise activation must survive"
+      assert_equal "${DIRENV_ACTIVATED:-}" "1" "direnv activation must survive"
+      assert_equal "$OPENCODE_ENABLE_EXA" "true" "managed OpenCode setting must survive"
+      actual="$PATH"
+      ;;
+    refresh)
+      for tool in mkdir touch mktemp awk cat cmp cp mv rm; do
+        eval "$tool() { PATH=\"\$tools_path\" command $tool \"\$@\"; }"
+      done
+      DRY_RUN=0
+      PATH="$initial"
+      ensure_shell_configuration >/dev/null
+      assert_equal "$PATH" "$expected" "$site: $label"
+      ensure_shell_configuration >/dev/null
+      actual="$PATH"
+      ;;
+  esac
+  assert_equal "$actual" "$expected" "$site: repeated $label"
+)
+
+test_managed_path_guards_at_all_sites() (
+  local HOME="$TEMP_DIR/path home [x]*" site initial expected
+  DRY_RUN=0
+  mkdir -p "$HOME/.local/bin" "$HOME/bin" "$HOME/.opencode/bin"
+  printf '%s\n' '#!/bin/bash' 'printf "%s\n" "MISE_ACTIVATED=1"' > "$HOME/.local/bin/mise"
+  chmod 755 "$HOME/.local/bin/mise"
+  ensure_shell_configuration >/dev/null
+
+  for site in bootstrap block refresh; do
+    initial='/usr/bin:/bin'
+    expected="$HOME/.local/bin:$HOME/bin:$HOME/.opencode/bin:$initial"
+    assert_managed_path "$site" "$initial" "$expected" 'new directory priority'
+    assert_managed_path "$site" '' "$HOME/.local/bin:$HOME/bin:$HOME/.opencode/bin:" 'empty PATH entry'
+
+    initial="$HOME/bin:/usr/bin::$HOME/.opencode/bin:$HOME/.local/bin:$HOME/bin:"
+    assert_managed_path "$site" "$initial" "$initial" 'existing entries and duplicates stay in order'
+    initial="$HOME/.local/bin:/usr/bin:$HOME/.opencode/bin"
+    assert_managed_path "$site" "$initial" "$HOME/bin:$initial" 'only the missing exact entry is prepended'
+
+    initial="$HOME/.local/bin-extra:$HOME/bin/tools:prefix$HOME/.opencode/bin:/usr/bin:"
+    expected="$HOME/.local/bin:$HOME/bin:$HOME/.opencode/bin:$initial"
+    assert_managed_path "$site" "$initial" "$expected" 'partial matches are not entries'
+  done
+
+  rm -rf "$HOME/bin" "$HOME/.opencode/bin"
+  touch "$HOME/bin"
+  for site in bootstrap block refresh; do
+    assert_managed_path "$site" '/usr/bin::/bin:' "$HOME/.local/bin:/usr/bin::/bin:" 'absent directories and regular files are skipped'
+  done
+
+  rm -rf "$HOME/.local/bin"
+  assert_managed_path bootstrap '' '' 'no directories exist'
+  # With no mise executable, exercise the block directly without the activation
+  # assertions used above for the all-sites matrix.
+  direnv() { :; }
+  PATH=''
+  source "$HOME/.bashrc"
+  assert_equal "$PATH" '' 'block: no directories exist'
+)
+
+test_shell_configuration_preserves_profiles_and_dry_run() (
+  local HOME="$TEMP_DIR/path-profile-home" before original_path="$PATH"
+  mkdir -p "$HOME"
+  printf '%s\n' '# user profile' > "$HOME/.bashrc"
+  DRY_RUN=1
+  ensure_shell_configuration >/dev/null
+  assert_equal "$PATH" "$original_path" 'dry-run must not refresh PATH'
+  assert_equal "$(<"$HOME/.bashrc")" '# user profile' 'dry-run must preserve the profile'
+  [[ ! -e "$HOME/.local" && ! -e "$HOME/.bashrc.pre-agentic-dev-toolkit" ]] || fail 'dry-run must not create directories or backups'
+
+  DRY_RUN=0
+  ensure_shell_configuration >/dev/null
+  assert_equal "$(<"$HOME/.bashrc.pre-agentic-dev-toolkit")" '# user profile' 'backup must preserve the original profile'
+  before="$(<"$HOME/.bashrc")"
+  [[ "$before" == '# user profile'* ]] || fail 'managed setup must preserve user content'
+  assert_equal "$(grep -c '^# >>> agentic-dev-toolkit >>>$' "$HOME/.bashrc")" '1' 'start marker must remain'
+  assert_equal "$(grep -c '^# <<< agentic-dev-toolkit <<<$' "$HOME/.bashrc")" '1' 'end marker must remain'
+  ensure_shell_configuration >/dev/null
+  local after="$(<"$HOME/.bashrc")" marker='# >>> agentic-dev-toolkit >>>'
+  assert_equal "${after#*"$marker"}" "${before#*"$marker"}" 'repeated setup must preserve the managed block'
+  assert_equal "$(grep -c '^# >>> agentic-dev-toolkit >>>$' "$HOME/.bashrc")" '1' 'repeated setup must keep one managed block'
+  assert_equal "$(<"$HOME/.bashrc.pre-agentic-dev-toolkit")" '# user profile' 'repeated setup must preserve the first backup'
+)
+
