-export PATH="$HOME/.local/bin:$HOME/bin:$HOME/.opencode/bin:$PATH"
+# Prepends each managed bin directory that exists and is not already an exact
+# PATH entry. Walking the list in reverse keeps .local/bin, bin, .opencode/bin
+# in that priority order. ${PATH+:$PATH} keeps every existing entry verbatim,
+# including the single empty entry of an empty PATH. The managed Bash block in
+# ensure_shell_configuration carries an inline copy of this loop.
+prepend_managed_path_entries() {
+  local dir
+  for dir in "$HOME/.opencode/bin" "$HOME/bin" "$HOME/.local/bin"; do
+    if [[ -d "$dir" && ":${PATH-}:" != *":$dir:"* ]]; then
+      PATH="$dir${PATH+:$PATH}"
+    fi
+  done
+  export PATH
+}
+
+prepend_managed_path_entries
 
 TEMP_PATHS=()
 DOWNLOADED_INSTALLER=""
