   cat >> "$temp_file" <<'EOF_BASHRC'
 
 # >>> agentic-dev-toolkit >>>
-export PATH="$HOME/.local/bin:$HOME/bin:$HOME/.opencode/bin:$PATH"
+for __adt_path_dir in "$HOME/.opencode/bin" "$HOME/bin" "$HOME/.local/bin"; do
