--- a/environments/linux/install.sh
+++ b/environments/linux/install.sh
@@ -59,7 +59,22 @@ CODEX_STANDALONE_ROOT="$CODEX_HOME/packages/standalone"
 GCM_WINDOWS_PATH="${ADT_GCM_PATH:-/mnt/c/Program Files/Git/mingw64/bin/git-credential-manager.exe}"
 GIT_CREDENTIAL_WRAPPER="${GIT_CREDENTIAL_WRAPPER:-$HOME/.local/bin/git-credential-manager-wsl}"
 
-export PATH="$HOME/.local/bin:$HOME/bin:$HOME/.opencode/bin:$PATH"
+# Prepends each managed bin directory that exists and is not already a complete
+# PATH entry. Walking the list in reverse keeps .local/bin first when all three
+# are added. Existing entries are never touched, including the single empty
+# entry an empty PATH consists of. ensure_shell_configuration emits the same
+# loop into ~/.bashrc; keep the two in step.
+prepend_managed_path_directories() {
+  local dir
+  for dir in "$HOME/.opencode/bin" "$HOME/bin" "$HOME/.local/bin"; do
+    if [[ -d "$dir" && ":${PATH-}:" != *":$dir:"* ]]; then
+      PATH="$dir:${PATH-}"
+    fi
+  done
+  export PATH
+}
+
+prepend_managed_path_directories
 
 TEMP_PATHS=()
 DOWNLOADED_INSTALLER=""
@@ -393,7 +408,13 @@ ensure_shell_configuration() {
   cat >> "$temp_file" <<'EOF_BASHRC'
 
 # >>> agentic-dev-toolkit >>>
-export PATH="$HOME/.local/bin:$HOME/bin:$HOME/.opencode/bin:$PATH"
+for __adt_path_dir in "$HOME/.opencode/bin" "$HOME/bin" "$HOME/.local/bin"; do
+  if [[ -d "$__adt_path_dir" && ":${PATH-}:" != *":$__adt_path_dir:"* ]]; then
+    PATH="$__adt_path_dir:${PATH-}"
+  fi
+done
+unset __adt_path_dir
+export PATH
 export OPENCODE_ENABLE_EXA=true
 if [[ -x "$HOME/.local/bin/mise" ]]; then
   eval "$("$HOME/.local/bin/mise" activate bash)"
@@ -410,7 +431,7 @@ EOF_BASHRC
     rm -f "$temp_file"
   fi
 
-  export PATH="$HOME/.local/bin:$HOME/bin:$HOME/.opencode/bin:$PATH"
+  prepend_managed_path_directories
 }
 
