{
  "name": "reviewer",
  "mode": "subagent",
  "model": "github-copilot/gpt-5.6-sol",
  "variant": "high",
  "tools": {
    "apply_patch": false,
    "bash": true,
    "task": false,
    "webfetch": true,
    "websearch": true
  },
  "permissions": {
    "edit": "deny",
    "task": "deny",
    "bash": {
      "wildcard": "deny",
      "allowed": [
        "git status*",
        "git diff*",
        "git log*",
        "git show*"
      ]
    },
    "webfetch": null,
    "websearch": "allow"
  }
}
