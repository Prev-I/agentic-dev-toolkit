def ensure_state(path):
    path = path.expanduser().resolve()
    for parent in (path, *path.parents):
        if (parent / ".git").exists():
            raise ObserveError("state_directory_inside_git_worktree")
    existed = path.exists()
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    if not existed:
        os.chmod(path, 0o700)
    return path


def key_for(state):
    path = state / "hash.key"
    if not path.exists():
        try:
            descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        except FileExistsError:
            pass
        else:
            with os.fdopen(descriptor, "wb") as handle:
                handle.write(secrets.token_bytes(32))
    return path.read_bytes()


def session_hash(key, sid):
    return hmac.new(key, sid.encode(), hashlib.sha256).hexdigest()[:16]


V1_REQUIRED = {
    "session": {"id", "parent_id", "directory", "version", "agent", "model", "time_created", "time_updated"},
    "message": {"id", "session_id", "time_created", "data"},
    "part": {"message_id", "session_id", "time_created", "data"},
}
V2_REQUIRED = {
    "session_v2": {"id", "parent_id", "directory", "version", "agent", "model", "time_created", "time_updated"},
    "session_message": {"id", "session_id", "type", "seq", "time_created", "data"},
}


def has_schema(db, required):
    tables = {row[0] for row in db.execute("SELECT name FROM sqlite_master WHERE type='table'")}
    for table, columns in required.items():
        if table not in tables:
            return False
        if not columns <= {row[1] for row in db.execute(f'PRAGMA table_info("{table}")')}:
            return False
    return True


def detect_schema(db):
    # A 2.x database keeps its frozen 1.x tables, so v2 must win when both match.
    tables = {row[0] for row in db.execute("SELECT name FROM sqlite_master WHERE type='table'")}
    if has_schema(db, V2_REQUIRED):
        return "v2"
    if "session_v2" in tables:
        # A 2.x database is never read through its frozen 1.x tables.
        raise ObserveError("unsupported_session_schema")
    if has_schema(db, V1_REQUIRED):
        return "v1"
    raise ObserveError("unsupported_session_schema")


def default_manifest_for(db_path):
    """(manifest path, schema it was chosen for). Only ObserveError falls back to v1."""
    root = Path(__file__).resolve().parent.parent
    v1 = root / "eval/manifests/current-routing-targets.json"
    v2 = root / "v2/manifests/current-routing-targets.json"
    try:
        path = Path(db_path).expanduser().resolve()
        if not path.is_file():
            return v1, "v1"
        db = sqlite3.connect(path.as_uri() + "?mode=ro", uri=True)
        try:
            schema = detect_schema(db)
        finally:
            db.close()
        return (v2 if schema == "v2" else v1), schema
    except ObserveError:
        return v1, "v1"  # the reader reports the real error
    # sqlite3.Error propagates: a guessed manifest must not be used (fail closed).


def default_manifest(db_path):
    return default_manifest_for(db_path)[0]


def manifest_format(path):
    fmt = json.loads(Path(path).read_text(encoding="utf-8")).get("format")
